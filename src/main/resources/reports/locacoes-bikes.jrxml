<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relatório de locações e devoluções (requisito 8) — formato JasperReports 7.
  Alimentado pelo JasperService com a lista de LocacaoRelatorioDTO (mesmos dados do GET /api/v1/locacoes/relatorio).
  Os estilos vêm do arquivo reports/styles/bikes-styles.jrtx, injetado pelo parâmetro REPORT_STYLES.
-->
<jasperReport name="locacoes-bikes" language="java"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0001">

    <template><![CDATA[$P{REPORT_STYLES}]]></template>

    <parameter name="REPORT_STYLES" forPrompting="false" class="net.sf.jasperreports.engine.JRTemplate"/>
    <parameter name="IMG_LOGO" forPrompting="false" class="java.io.InputStream"/>
    <parameter name="REPORT_TITLE" forPrompting="false" class="java.lang.String">
        <defaultValueExpression><![CDATA["Relatório de Locações e Devoluções"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_SUBTITLE" forPrompting="false" class="java.lang.String">
        <defaultValueExpression><![CDATA["Relação de todas as locações registradas"]]></defaultValueExpression>
    </parameter>
    <parameter name="GERADO_POR" forPrompting="false" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="nomeCliente" class="java.lang.String"/>
    <field name="codigoBicicleta" class="java.lang.String"/>
    <field name="dataRetirada" class="java.time.LocalDateTime"/>
    <field name="dataDevolucao" class="java.time.LocalDateTime"/>
    <field name="duracaoMinutos" class="java.lang.Long"/>
    <field name="duracao" class="java.lang.String"/>
    <field name="valor" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>

    <!-- Variáveis booleanas consumidas pelos estilos condicionais de bikes-styles.jrtx -->
    <variable name="ZEBRA" class="java.lang.Boolean">
        <expression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></expression>
    </variable>
    <variable name="LOCACAO_ATIVA" class="java.lang.Boolean">
        <expression><![CDATA["ATIVA".equals($F{status})]]></expression>
    </variable>

    <variable name="TOTAL_VALOR" calculation="Sum" class="java.math.BigDecimal">
        <expression><![CDATA[$F{valor} == null ? java.math.BigDecimal.ZERO : $F{valor}]]></expression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_ATIVAS" calculation="Sum" class="java.lang.Integer">
        <expression><![CDATA["ATIVA".equals($F{status}) ? 1 : 0]]></expression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_MINUTOS" calculation="Sum" class="java.lang.Long">
        <expression><![CDATA[$F{duracaoMinutos} == null ? 0L : $F{duracaoMinutos}]]></expression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>

    <title height="72">
        <element kind="image" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0002" x="0" y="0" width="150" height="50" usingCache="false" onErrorType="Blank">
            <expression><![CDATA[$P{IMG_LOGO}]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0003" x="165" y="2" width="637" height="28" style="Title">
            <expression><![CDATA[$P{REPORT_TITLE}]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0004" x="165" y="32" width="637" height="16" style="Subtitle">
            <expression><![CDATA[$P{REPORT_SUBTITLE}]]></expression>
        </element>
        <element kind="line" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0005" x="0" y="60" width="802" height="2">
            <pen lineWidth="2.0" lineColor="#1B5E20"/>
        </element>
    </title>

    <pageHeader height="18">
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0006" x="0" y="0" width="802" height="16" style="Footer">
            <expression><![CDATA["Gerado em " + java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy 'às' HH:mm"))
                + ($P{GERADO_POR} == null ? "" : " por " + $P{GERADO_POR})]]></expression>
        </element>
    </pageHeader>

    <columnHeader height="22">
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0010" x="0" y="0" width="40" height="22" hTextAlign="Center" style="ColumnHeader">
            <text><![CDATA[#]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0011" x="40" y="0" width="190" height="22" style="ColumnHeader">
            <text><![CDATA[Cliente]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0012" x="230" y="0" width="90" height="22" style="ColumnHeader">
            <text><![CDATA[Bicicleta]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0013" x="320" y="0" width="110" height="22" style="ColumnHeader">
            <text><![CDATA[Retirada]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0014" x="430" y="0" width="110" height="22" style="ColumnHeader">
            <text><![CDATA[Devolução]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0015" x="540" y="0" width="90" height="22" hTextAlign="Center" style="ColumnHeader">
            <text><![CDATA[Duração]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0016" x="630" y="0" width="82" height="22" hTextAlign="Right" style="ColumnHeader">
            <text><![CDATA[Valor (R$)]]></text>
        </element>
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0017" x="712" y="0" width="90" height="22" hTextAlign="Center" style="ColumnHeader">
            <text><![CDATA[Status]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="18">
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0020" x="0" y="0" width="40" height="18" style="DetailCenter">
                <expression><![CDATA[$F{id}]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0021" x="40" y="0" width="190" height="18" textAdjust="StretchHeight" style="Detail">
                <expression><![CDATA[$F{nomeCliente}]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0022" x="230" y="0" width="90" height="18" style="Detail">
                <expression><![CDATA[$F{codigoBicicleta}]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0023" x="320" y="0" width="110" height="18" style="Detail">
                <expression><![CDATA[$F{dataRetirada} == null ? "-" : $F{dataRetirada}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0024" x="430" y="0" width="110" height="18" style="Detail">
                <expression><![CDATA[$F{dataDevolucao} == null ? "-" : $F{dataDevolucao}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0025" x="540" y="0" width="90" height="18" style="DetailCenter">
                <expression><![CDATA[$F{duracao}]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0026" x="630" y="0" width="82" height="18" style="DetailNumber">
                <expression><![CDATA[$F{valor} == null ? "-" : new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols($P{REPORT_LOCALE})).format($F{valor})]]></expression>
            </element>
            <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0027" x="712" y="0" width="90" height="18" style="DetailStatus">
                <expression><![CDATA["ATIVA".equals($F{status}) ? "Em andamento" : "Finalizada"]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="20">
        <element kind="staticText" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0030" x="0" y="4" width="400" height="14" style="Footer">
            <text><![CDATA[Bikes — Locadora de Bicicletas · IFC Campus Videira]]></text>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0031" x="602" y="4" width="150" height="14" hTextAlign="Right" style="Footer">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0032" x="754" y="4" width="48" height="14" evaluationTime="Report" style="Footer">
            <expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

    <summary height="46">
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0040" x="0" y="8" width="802" height="30" style="NoData">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression>
            <expression><![CDATA["Nenhuma locação registrada."]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0041" x="0" y="4" width="320" height="20" style="Total">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} > 0]]></printWhenExpression>
            <expression><![CDATA["Total de locações: " + $V{REPORT_COUNT} + "  ·  Em andamento: " + $V{TOTAL_ATIVAS} + "  ·  Finalizadas: " + ($V{REPORT_COUNT} - $V{TOTAL_ATIVAS})]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0042" x="320" y="4" width="310" height="20" hTextAlign="Right" style="Total">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} > 0]]></printWhenExpression>
            <expression><![CDATA["Tempo total de utilização: " + ($V{TOTAL_MINUTOS} / 60) + "h " + String.format("%02d", $V{TOTAL_MINUTOS} % 60) + "min"]]></expression>
        </element>
        <element kind="textField" uuid="2b7f6a0e-4c1d-4d4a-9a0a-1c5e1f0a0043" x="630" y="4" width="172" height="20" style="TotalNumber">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} > 0]]></printWhenExpression>
            <expression><![CDATA["Total faturado: R$ " + new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols($P{REPORT_LOCALE})).format($V{TOTAL_VALOR})]]></expression>
        </element>
    </summary>
</jasperReport>
