# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bikes

# Graylog
# GRAYLOG_PASSWORD_SECRET deve ter >= 16 caracteres e NÃO conter $ (Compose interpola)
GRAYLOG_PASSWORD_SECRET=bikesgraylogsecretkey2024ifc
# SHA2 de "admin": echo -n admin | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
